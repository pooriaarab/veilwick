{
  "identifier": "default",
  "description": "Capabilities for the main window: notifications, deep links, window state, updater, and stronghold (encrypted local secrets). Default-deny: every permission below is opted in for a plugin we actually call from JS.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "deep-link:default",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "stronghold:default",
    "stronghold:allow-initialize",
    "stronghold:allow-save",
    "stronghold:allow-get-store-record",
    "stronghold:allow-save-store-record"
  ]
}
